{
  "cSpell.words": [
    "omniselect",
    "overlay",
    "svelte",
    "tsbuildinfo",
    "vite",
    "zealakit",
    "listbox",
    "combobox",
    "activedescendant",
    "typeahead",
    "multiselect",
    "describedby",
    "labelledby",
    "esbuild",
    "oxc",
    "oxfmt",
    "oxlint"
  ],
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  }
}
