{
  "name": "@zealakit/omniselect",
  "version": "1.0.0-beta.1",
  "private": true,
  "description": "Headless, accessible selection components for building modern UIs.",
  "keywords": [
    "select",
    "combobox",
    "listbox",
    "multiselect",
    "autocomplete",
    "headless",
    "a11y",
    "ui",
    "zealakit",
    "react",
    "vue",
    "svelte",
    "vanilla"
  ],
  "author": "nqhed - Huy Ed. Nguyen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zealakit/omniselect.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "build:core": "pnpm --filter @zealakit/omniselect-core run build",
    "build:vanilla": "pnpm --filter @zealakit/omniselect-vanilla run build",
    "build:react": "pnpm --filter @zealakit/omniselect-react run build",
    "build:vue": "pnpm --filter @zealakit/omniselect-vue run build",
    "build:svelte": "pnpm --filter @zealakit/omniselect-svelte run build",
    "typecheck": "pnpm -r --filter './packages/*' run typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm build && pnpm typecheck && pnpm test && pnpm lint && pnpm format:check && pnpm check:engine-usage && pnpm check:dom-private && pnpm check:html-sinks && pnpm check:internal-leak && pnpm check:file-names && pnpm check:size-regression",
    "clean": "pnpm -r exec rm -rf dist .next && rm -rf artifacts",
    "dev:vanilla": "pnpm --filter @zealakit/omniselect-vanilla-example run dev",
    "dev:react": "pnpm --filter @zealakit/omniselect-react-example run dev",
    "dev:vue": "pnpm --filter @zealakit/omniselect-vue-example run dev",
    "dev:svelte": "pnpm --filter @zealakit/omniselect-svelte-example run dev",
    "dev:nextjs": "pnpm --filter @zealakit/omniselect-nextjs-example run dev",
    "monitor": "node --strip-types monitor/server.ts",
    "test": "pnpm --filter @zealakit/omniselect-core run test && pnpm --filter @zealakit/omniselect-vanilla run test && pnpm --filter @zealakit/omniselect-react run test && pnpm --filter @zealakit/omniselect-vue run test && pnpm --filter @zealakit/omniselect-svelte run test",
    "readme:check": "node scripts/check-readmes.mjs",
    "pack:packages": "node scripts/pack-packages.mjs",
    "release:check": "pnpm check:local-engine && pnpm check && pnpm size && pnpm pack:packages",
    "npm:publish:check": "pnpm check:local-engine && node --strip-types scripts/npm-publish.ts check",
    "npm:publish:vanilla": "pnpm check:local-engine && node --strip-types scripts/npm-publish.ts vanilla",
    "npm:publish:react": "pnpm check:local-engine && node --strip-types scripts/npm-publish.ts react",
    "npm:publish:vue": "pnpm check:local-engine && node --strip-types scripts/npm-publish.ts vue",
    "npm:publish:svelte": "pnpm check:local-engine && node --strip-types scripts/npm-publish.ts svelte",
    "npm:publish:all": "pnpm check:local-engine && node --strip-types scripts/npm-publish.ts all",
    "size": "node scripts/size.mjs",
    "check:engine-usage": "node scripts/check-engine-usage.mjs",
    "check:dom-private": "node scripts/check-dom-private.mjs",
    "check:local-engine": "node scripts/check-local-engine.mjs",
    "check:html-sinks": "node scripts/check-html-sinks.mjs",
    "check:internal-leak": "node scripts/check-internal-leak.mjs",
    "check:file-names": "node scripts/check-file-names.mjs",
    "check:engine-peer": "node scripts/check-engine-usage.mjs",
    "check:size-regression": "node scripts/check-size-regression.mjs",
    "size:baseline": "node scripts/check-size-regression.mjs --write"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "axe-core": "^4.14.1",
    "esbuild": "^0.28.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "typescript": "^6.0.3"
  }
}
