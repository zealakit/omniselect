{
  "name": "@zealakit/omniselect-react",
  "version": "1.0.0",
  "description": "Accessible, headless Select and Combobox primitives for React.",
  "keywords": [
    "select",
    "combobox",
    "listbox",
    "multiselect",
    "autocomplete",
    "headless",
    "zealakit",
    "react",
    "react-hook",
    "react-component"
  ],
  "author": "nqhed - Huy Ed. Nguyen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zealakit/omniselect.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/zealakit/omniselect#readme",
  "bugs": {
    "url": "https://github.com/zealakit/omniselect/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./native": {
      "types": "./dist/native/index.d.ts",
      "import": "./dist/native/index.js",
      "default": "./dist/native/index.js"
    },
    "./package.json": "./package.json",
    "./select": {
      "types": "./dist/select/index.d.ts",
      "import": "./dist/select/index.js",
      "default": "./dist/select/index.js"
    }
  },
  "dependencies": {
    "@zealakit/omniselect-core": "workspace:^",
    "@zealakit/overlay-react": "^1.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit",
    "test": "pnpm build && node --import ./tests/setup.ts --test tests/*.test.ts",
    "test:watch": "node --import ./tests/setup.ts --test --watch tests/*.test.ts",
    "clean": "rm -rf dist",
    "prepack": "pnpm run build"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  }
}
